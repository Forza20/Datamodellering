annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ExcelSti","Kilde","slv_customer","slv_address","slv_city","slv_credit","slv_contact","slv_product","slv_subcategory","slv_order","slv_order_line","slv_campaign_log","slv_campaign_sku","slv_inventory","slv_sales_target","slv_security","dim_date","dim_customer","dim_product","dim_channel","dim_region","dim_campaign","bridge_campaign_product","fact_sales","fact_campaign_spend","fact_inventory","fact_sales_target","security"]

