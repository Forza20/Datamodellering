/// Kundedimension samlet fra kundestamdata, adresse, by, kreditgrænse og kontaktperson. Har en Ukendt-række med nøgle -1.
table dim_customer
	lineageTag: 810ab4eb-4688-4991-adaf-c474da893df4

	/// Surrogatnøgle for kunden, fortløbende nummer genereret i Power Query. -1 = Ukendt.
	column customer_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 424ab005-ddc3-4268-a661-b57b477383e0
		summarizeBy: none
		sourceColumn: customer_key

		annotation SummarizationSetBy = Automatic

	/// Kundens id i kundestamdata (CUST_MASTER).
	column customer_id
		dataType: int64
		formatString: 0
		lineageTag: 1040bf1f-49b5-4bdd-a916-16e55d4192f1
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

	/// Kundens navn.
	column customer_name
		dataType: string
		lineageTag: 50c3e20f-6d6e-49d8-bc3e-ff9cad0e6f5b
		summarizeBy: none
		sourceColumn: customer_name

		annotation SummarizationSetBy = Automatic

	/// Kundesegment.
	column segment
		dataType: string
		lineageTag: d29c951e-89ea-43c3-bb77-156ffa62cc40
		summarizeBy: none
		sourceColumn: segment

		annotation SummarizationSetBy = Automatic

	/// Ansvarlig account manager for kunden.
	column account_manager
		dataType: string
		lineageTag: b5f8f66b-79f9-4082-80e0-2b6d5a14c052
		summarizeBy: none
		sourceColumn: account_manager

		annotation SummarizationSetBy = Automatic

	/// Kundens betalingsbetingelser.
	column payment_terms
		dataType: string
		lineageTag: 5b79eafa-ee6f-4395-90c3-c7e424fd5d40
		summarizeBy: none
		sourceColumn: payment_terms

		annotation SummarizationSetBy = Automatic

	/// Kundens kreditgrænse i kroner.
	column credit_limit
		dataType: decimal
		formatString: #,0.00
		lineageTag: 586c384d-5544-46e0-b1e4-48947483704a
		summarizeBy: none
		sourceColumn: credit_limit

		annotation SummarizationSetBy = Automatic

	/// Kundens gadeadresse.
	column street
		dataType: string
		lineageTag: 74398215-3977-4a07-a9e7-24df59ccfdf4
		summarizeBy: none
		sourceColumn: street

		annotation SummarizationSetBy = Automatic

	/// Kundens by.
	column city
		dataType: string
		lineageTag: b95efd47-f5eb-42b4-97e4-4a869d1a7f68
		summarizeBy: none
		sourceColumn: city

		annotation SummarizationSetBy = Automatic

	/// Region for kundens by.
	column region
		dataType: string
		lineageTag: caf1f76e-3fb4-4d34-9f4b-2a6a99ccee30
		summarizeBy: none
		sourceColumn: region

		annotation SummarizationSetBy = Automatic

	/// Kundens primære kontaktperson.
	column primary_contact
		dataType: string
		lineageTag: a59d0f0e-a676-4a30-a876-47161f16dbaa
		summarizeBy: none
		sourceColumn: primary_contact

		annotation SummarizationSetBy = Automatic

	partition dim_customer = m
		mode: import
		queryGroup: Gold
		source =
				let
					Adresse = Table.NestedJoin(slv_customer, {"AddressID"}, slv_address, {"AddressID"}, "Adr", JoinKind.LeftOuter),
					AdresseUd = Table.ExpandTableColumn(Adresse, "Adr", {"Street", "CityName"}),
					By = Table.NestedJoin(AdresseUd, {"CityName"}, slv_city, {"CityName"}, "By", JoinKind.LeftOuter),
					ByUd = Table.ExpandTableColumn(By, "By", {"RegionName"}),
					Kredit = Table.NestedJoin(ByUd, {"CustomerID"}, slv_credit, {"CustomerID"}, "Kr", JoinKind.LeftOuter),
					KreditUd = Table.ExpandTableColumn(Kredit, "Kr", {"CreditLimit"}),
					Kontakt = Table.NestedJoin(KreditUd, {"CustomerID"}, slv_contact, {"CustomerID"}, "Ko", JoinKind.LeftOuter),
					KontaktUd = Table.ExpandTableColumn(Kontakt, "Ko", {"ContactName"}),
					Sorteret = Table.Buffer(Table.Sort(KontaktUd, {{"CustomerID", Order.Ascending}})),
					MedKey = Table.AddIndexColumn(Sorteret, "customer_key", 1, 1, Int64.Type),
					Omdoebt = Table.RenameColumns(MedKey, {{"CustomerID", "customer_id"}, {"CustomerName", "customer_name"}, {"Segment", "segment"}, {"AccountManager", "account_manager"}, {"PaymentTerms", "payment_terms"}, {"CreditLimit", "credit_limit"}, {"Street", "street"}, {"CityName", "city"}, {"RegionName", "region"}, {"ContactName", "primary_contact"}}),
					Valgt = Table.SelectColumns(Omdoebt, {"customer_key", "customer_id", "customer_name", "segment", "account_manager", "payment_terms", "credit_limit", "street", "city", "region", "primary_contact"}),
					Typer = Table.TransformColumnTypes(Valgt, {{"customer_key", Int64.Type}, {"customer_id", Int64.Type}, {"customer_name", type text}, {"segment", type text}, {"account_manager", type text}, {"payment_terms", type text}, {"credit_limit", Currency.Type}, {"street", type text}, {"city", type text}, {"region", type text}, {"primary_contact", type text}}),
					Ukendt = #table(Value.Type(Typer), {{-1, null, "Ukendt", null, null, null, null, null, null, null, null}}),
					Samlet = Table.Combine({Typer, Ukendt})
				in
					Samlet

	annotation PBI_ResultType = Table
