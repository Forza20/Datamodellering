			Ark = Kilde{[Item = "user_details", Kind = "Sheet"]}[Data],
			Headers = Table.PromoteHeaders(Ark, [PromoteAllScalars = true]),
			Valgt = Table.SelectColumns(Headers, {"UserID", "CreditLimit"}),
