expression slv_campaign_sku =
		let
			Ark = Kilde{[Item = "campaign_skus", Kind = "Sheet"]}[Data],
			Headers = Table.PromoteHeaders(Ark, [PromoteAllScalars = true]),
			Typer = Table.TransformColumnTypes(Headers, {{"CampaignName", type text}, {"PromotedSKUs", type text}}, "en-US"),
			// En celle med flere SKU'er -> en raekke pr. SKU
			SomListe = Table.TransformColumns(Typer, {{"PromotedSKUs", each List.Transform(Text.Split(_, ","), Text.Trim)}}),
			Udfoldet = Table.ExpandListColumn(SomListe, "PromotedSKUs"),
			Omdoebt = Table.RenameColumns(Udfoldet, {{"PromotedSKUs", "ProductCode"}}),
			Typer2 = Table.TransformColumnTypes(Omdoebt, {{"ProductCode", type text}}),
			Trimmet = Table.TransformColumns(Typer2, {{"CampaignName", Text.Trim, type text}}),
			Unikke = Table.Distinct(Trimmet)
		in
			Unikke
	lineageTag: 5a5e9b43-9c22-4ce2-a404-43178b946103
	queryGroup: Silver

	annotation PBI_ResultType = Table

expression slv_inventory =
		let
			Ark = Kilde{[Item = "inventory", Kind = "Sheet"]}[Data],
			Headers = Table.PromoteHeaders(Ark, [PromoteAllScalars = true]),
			// Bredt ark: en kolonne pr. maaned -> en raekke pr. produkt pr. maaned
			Unpivot = Table.UnpivotOtherColumns(Headers, {"ProductName"}, "Period", "StockQty"),
			Typer = Table.TransformColumnTypes(Unpivot, {{"ProductName", type text}, {"Period", type text}, {"StockQty", Int64.Type}}, "en-US"),
			Trimmet = Table.TransformColumns(Typer, {{"ProductName", Text.Trim, type text}, {"Period", Text.Trim, type text}}),
			MedDato = Table.AddColumn(Trimmet, "MonthStart", each Date.FromText([Period] & "-01", [Format = "yyyy-MM-dd"]), type date),
			Valgt = Table.SelectColumns(MedDato, {"ProductName", "MonthStart", "StockQty"})
		in
			Valgt
	lineageTag: cb2a3235-8d13-4b82-9034-798917e9c5bb
	queryGroup: Silver

	annotation PBI_ResultType = Table

expression slv_sales_target =
		let
			Ark = Kilde{[Item = "sales_targets", Kind = "Sheet"]}[Data],
			Headers = Table.PromoteHeaders(Ark, [PromoteAllScalars = true]),
			Typer = Table.TransformColumnTypes(Headers, {{"Period", type text}, {"TargetRevenue", type number}}, "en-US"),
			MedDato = Table.AddColumn(Typer, "MonthStart", each Date.FromText(Text.Trim([Period]) & "-01", [Format = "yyyy-MM-dd"]), type date),
			Valgt = Table.SelectColumns(MedDato, {"MonthStart", "TargetRevenue"}),
			Unikke = Table.Distinct(Valgt, {"MonthStart"})
		in
			Unikke
	lineageTag: e208f85d-300d-49b7-9731-9118348b24bf
	queryGroup: Silver

	annotation PBI_ResultType = Table

expression slv_security =
		let
			Ark = Kilde{[Item = "security", Kind = "Sheet"]}[Data],
			Headers = Table.PromoteHeaders(Ark, [PromoteAllScalars = true]),
			Typer = Table.TransformColumnTypes(Headers, {{"UserEmail", type text}, {"Region", type text}}, "en-US"),
			Trimmet = Table.TransformColumns(Typer, {{"UserEmail", each Text.Lower(Text.Trim(_)), type text}, {"Region", Text.Trim, type text}}),
			Unikke = Table.Distinct(Trimmet, {"UserEmail"})
