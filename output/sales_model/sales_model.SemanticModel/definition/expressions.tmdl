expression slv_product =
		let
			Ark = Kilde{[Item = "products", Kind = "Sheet"]}[Data],
			Headers = Table.PromoteHeaders(Ark, [PromoteAllScalars = true]),
			Valgt = Table.SelectColumns(Headers, {"ProductCode", "ProductName", "Brand", "SubcategoryName", "UnitPrice", "PrimarySupplier"}),
			Typer = Table.TransformColumnTypes(Valgt, {{"ProductCode", type text}, {"ProductName", type text}, {"Brand", type text}, {"SubcategoryName", type text}, {"UnitPrice", type number}, {"PrimarySupplier", type text}}, "en-US"),
			Trimmet = Table.TransformColumns(Typer, {{"ProductCode", Text.Trim, type text}, {"ProductName", Text.Trim, type text}, {"Brand", Text.Trim, type text}, {"SubcategoryName", Text.Trim, type text}, {"PrimarySupplier", Text.Trim, type text}}),
			// Fjern testproduktet og de tomme dubletter (ingen brand/pris)
			UdenTest = Table.SelectRows(Trimmet, each [ProductCode] <> "ZZZ-000" and [Brand] <> null and [Brand] <> ""),
			UnikKode = Table.Distinct(UdenTest, {"ProductCode"}),
			UnikNavn = Table.Distinct(UnikKode, {"ProductName"})
		in
			UnikNavn
	lineageTag: 9694f98a-9342-4ac4-9a69-abb80c61aef3
	queryGroup: Silver

	annotation PBI_ResultType = Table

expression slv_subcategory =
		let
			Ark = Kilde{[Item = "subcategories", Kind = "Sheet"]}[Data],
			Headers = Table.PromoteHeaders(Ark, [PromoteAllScalars = true]),
			Typer = Table.TransformColumnTypes(Headers, {{"CategorySubcategory", type text}}, "en-US"),
			Delt = Table.SplitColumn(Typer, "CategorySubcategory", Splitter.SplitTextByDelimiter("|"), {"Category", "Subcategory"}),
			Pyntet = Table.TransformColumns(Delt, {{"Category", each Text.Proper(Text.Trim(_)), type text}, {"Subcategory", each Text.Proper(Text.Trim(_)), type text}}),
			Unikke = Table.Distinct(Pyntet, {"Subcategory"})
		in
			Unikke
	lineageTag: f32ed54f-2966-46ca-95c9-1616965ff76f
	queryGroup: Silver

	annotation PBI_ResultType = Table

expression slv_order =
		let
			Ark25 = Table.PromoteHeaders(Kilde{[Item = "ORDERS_2025", Kind = "Sheet"]}[Data], [PromoteAllScalars = true]),
			Ark26 = Table.PromoteHeaders(Kilde{[Item = "ORDERS_2026", Kind = "Sheet"]}[Data], [PromoteAllScalars = true]),
			// 2025 har ekstra kolonner (LegacyRef, SourceFile) - reducer til faelles kolonner
			Kolonner = {"OrderID", "CustomerName", "RegionName", "OrderDate", "OrderChannel", "Status", "Priority"},
			Samlet = Table.Combine({Table.SelectColumns(Ark25, Kolonner), Table.SelectColumns(Ark26, Kolonner)}),
			Typer = Table.TransformColumnTypes(Samlet, {{"OrderID", type text}, {"CustomerName", type text}, {"RegionName", type text}, {"OrderDate", type datetime}, {"OrderChannel", Int64.Type}, {"Status", type text}, {"Priority", type text}}, "en-US"),
			KunDato = Table.TransformColumns(Typer, {{"OrderDate", Date.From, type date}}),
			Trimmet = Table.TransformColumns(KunDato, {{"OrderID", Text.Trim, type text}, {"CustomerName", Text.Trim, type text}, {"RegionName", Text.Trim, type text}, {"Status", Text.Trim, type text}, {"Priority", Text.Trim, type text}}),
			Unikke = Table.Distinct(Trimmet, {"OrderID"})
		in
			Unikke
	lineageTag: 396ee83c-f683-4c5d-9e15-5a342411d36d
	queryGroup: Silver

	annotation PBI_ResultType = Table

expression slv_order_line =
		let
			Ark = Kilde{[Item = "order_line_items", Kind = "Sheet"]}[Data],
			Headers = Table.PromoteHeaders(Ark, [PromoteAllScalars = true]),
			Valgt = Table.SelectColumns(Headers, {"LineID", "OrderID", "ProductName", "Quantity", "UnitPrice", "UnitCost", "DiscountPct", "LineTotal"}),
			Typer = Table.TransformColumnTypes(Valgt, {{"LineID", type text}, {"OrderID", type text}, {"ProductName", type text}, {"Quantity", Int64.Type}, {"UnitPrice", type number}, {"UnitCost", type number}, {"DiscountPct", type number}, {"LineTotal", type number}}, "en-US"),
			Trimmet = Table.TransformColumns(Typer, {{"LineID", Text.Trim, type text}, {"OrderID", Text.Trim, type text}, {"ProductName", Text.Trim, type text}}),
			Rabat0 = Table.ReplaceValue(Trimmet, null, 0, Replacer.ReplaceValue, {"DiscountPct"}),
			Unikke = Table.Distinct(Rabat0, {"LineID"})
		in
			Unikke
	lineageTag: eee4e58f-cab0-4d3b-ac16-b94f95dac7d6
	queryGroup: Silver

	annotation PBI_ResultType = Table

expression slv_campaign_log =
		let
			Ark = Kilde{[Item = "CAMPAIGN_LOG", Kind = "Sheet"]}[Data],
			Headers = Table.PromoteHeaders(Ark, [PromoteAllScalars = true]),
			Valgt = Table.SelectColumns(Headers, {"CampaignName", "Channel", "StartDate", "EndDate", "Budget", "Date", "Impressions", "Clicks", "Spend"}),
			Typer = Table.TransformColumnTypes(Valgt, {{"CampaignName", type text}, {"Channel", type text}, {"StartDate", type date}, {"EndDate", type date}, {"Budget", type number}, {"Date", type date}, {"Impressions", Int64.Type}, {"Clicks", Int64.Type}, {"Spend", type number}}, "en-US"),
			Trimmet = Table.TransformColumns(Typer, {{"CampaignName", Text.Trim, type text}, {"Channel", Text.Trim, type text}}),
			Unikke = Table.Distinct(Trimmet, {"CampaignName", "Date"})
		in
			Unikke
	lineageTag: aff72eed-3cda-4492-8539-ccb99e5690df
