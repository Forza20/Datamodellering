/// Supabase session pooler-host (Connect > Session pooler). Pladsholder i repoet – sæt din egen host lokalt,
/// og ret værdien tilbage til pladsholderen før commit (beslutning R4-1).
expression PgServer = "aws-0-REGION.pooler.supabase.com" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 31b5be63-a09d-45fc-9f8d-be5a7c877f85
	queryGroup: Parametre

	annotation PBI_ResultType = Text

	annotation PBI_NavigationStepName = Navigation

expression PgDatabase = "postgres" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 5c92e2c1-a398-4b95-9655-c49cafbad423
	queryGroup: Parametre

	annotation PBI_ResultType = Text

/// Fælles forbindelse til Supabase. Login: powerbi_reader.<project-ref> (Database-credentials).
expression GoldKilde =
		let
			Kilde = PostgreSQL.Database(PgServer, PgDatabase)
		in
			Kilde
	lineageTag: cdf55f21-a59d-4b97-b993-41ff3e2e02aa
	queryGroup: Parametre

	annotation PBI_ResultType = Table

